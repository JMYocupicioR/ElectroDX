# Copiar a .env.local y a las variables del hosting. Nunca commitear secretos.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux (video + live broadcast)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Stripe (pagos)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# LiveKit (sesiones interactivas). UI admin: NEXT_PUBLIC_LIVEKIT_ENABLED=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_ENABLED=false

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# QR de asistencia (si falta, se firma con SUPABASE_SERVICE_ROLE_KEY)
QR_ATTENDANCE_HMAC_SECRET=
